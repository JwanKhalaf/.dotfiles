# systemctl
alias st="sudo systemctl status"
alias enable="sudo systemctl enable"
alias start="sudo systemctl start"
alias stop="sudo systemctl stop"
alias restart="sudo systemctl restart"

# docker
alias dp="docker ps"
alias di="docker image ls"
alias dv="docker volume ls"
alias dvc="docker volume prune"
alias dcr="docker container rm"
alias dir="docker image rm"

# configs
alias zrc="nvim ~/.config/zsh/.zshrc"
alias vrc="nvim ~/.config/nvim/init.lua"
alias xrc="nvim ~/.xinitrc"

# journal
alias j="journalctl"

# linux basic commands
alias l="exa -lhg --group-directories-first"
alias la="exa -lahg --group-directories-first"
alias cat="bat"
alias tree="tree -L 8 -I 'node_modules|cdk.out|elm-stuff|bin|obj' --dirsfirst"

# programs
alias cd="z"
alias v="nvim"
alias i="sxiv"
alias ydl="yt-dlp -x --audio-format wav"
alias cal="cal -m"
alias el="elm-land"
alias els="elm-land server"
alias tf="terraform"
alias tfl="terraform fmt --recursive && tflint --recursive"
alias cl="claude"
alias clc="claude --continue"

# shortcuts
alias ep="echo $PATH"
alias h="cd"
alias c="clear"
alias e="exit"
alias t="tmux"

# work directories
alias w="cd ~/code/gm/app/"
alias wf="cd ~/code/gm/frontend/"

# golang specific shortcuts
alias gt="go test ./..."

# dotnet
alias dw="dotnet watch --project src/Core --launch-profile https"
alias r="./reset.sh"
